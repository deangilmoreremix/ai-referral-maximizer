# OpenAI API Key (required for GPT-5 content generation)
# Must have access to GPT-5 models and Responses API
OPENAI_API_KEY=

# Default GPT-5 model to use
OPENAI_MODEL=gpt-5

# Supabase Configuration (required for user data and edge functions)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Legacy Gemini API Key (can be removed when fully migrated to OpenAI)
VITE_GEMINI_API_KEY=

# Unipile API Configuration (required for messaging and social media integration)
# Unipile provides unified API for SMS, WhatsApp, social media messaging, and contact management
# Obtain API key from: https://unipile.com (sign up and navigate to API settings)
UNIPILE_API_KEY=

# DropCowboy API Configuration (required for voice drop campaigns and text-to-speech)
# DropCowboy provides voice drop campaigns and text-to-speech generation services
# Obtain API key from: https://dropcowboy.com (sign up and navigate to API settings)
DROPCOWBOY_API_KEY=

# DropCowboy API Base URL (optional - defaults to https://api.dropcowboy.com/v1)
# Only change if using a custom endpoint or different region
DROPCOWBOY_API_URL=https://api.dropcowboy.com/v1