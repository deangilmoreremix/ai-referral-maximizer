# OpenAI API Key (required for GPT-5 content generation)
# Must have access to GPT-5 models and Responses API
OPENAI_API_KEY=

# Default GPT-5 model to use
OPENAI_MODEL=gpt-5

# Supabase Configuration (required for user data and edge functions)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Legacy Gemini API Key (can be removed when fully migrated to OpenAI)
VITE_GEMINI_API_KEY=